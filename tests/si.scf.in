&control
    calculation = 'scf'
    prefix      = 'si'
    pseudo_dir  = '@PSEUDO_DIR@'
    outdir      = '@OUTDIR@'
/
&system
    ibrav     = 2
    celldm(1) = 10.20
    nat       = 2
    ntyp      = 1
    ecutwfc   = 18.0
/
&electrons
    conv_thr = 1.0d-10
/
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS automatic
 4 4 4 1 1 1
